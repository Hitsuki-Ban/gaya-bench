{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://gaya-bench.local/schema/assignments-v1.schema.json",
  "title": "Gaya Bench 参考バンドル割当 v1",
  "type": "object",
  "required": ["schema_version", "assignments"],
  "additionalProperties": false,
  "properties": {
    "schema_version": { "const": "assignments-v1" },
    "assignments": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "required": ["subject_id", "bundle_id", "usage"],
        "additionalProperties": false,
        "properties": {
          "subject_id": {
            "type": "string",
            "pattern": "^[a-z0-9]+(?:-[a-z0-9]+)*/[a-z0-9]+(?:-[a-z0-9]+)*$"
          },
          "bundle_id": {
            "type": "string",
            "pattern": "^[a-z0-9]+(?:-[a-z0-9]+)*$"
          },
          "usage": { "enum": ["production", "evaluation"] }
        }
      }
    }
  }
}
