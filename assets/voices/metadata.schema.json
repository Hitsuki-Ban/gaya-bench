{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://gaya-bench.local/schema/voice-metadata.schema.json",
  "title": "Gaya Bench reference voice metadata",
  "type": "object",
  "additionalProperties": false,
  "required": ["format_version", "voices"],
  "properties": {
    "format_version": {
      "const": 1
    },
    "voices": {
      "type": "array",
      "minItems": 5,
      "items": {
        "$ref": "#/$defs/voice"
      }
    }
  },
  "$defs": {
    "sha256": {
      "type": "string",
      "pattern": "^[0-9a-f]{64}$"
    },
    "url": {
      "type": "string",
      "format": "uri",
      "pattern": "^https://"
    },
    "voice": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "id",
        "file",
        "sha256",
        "duration_sec",
        "language",
        "transcript",
        "transcript_rights",
        "source",
        "rights",
        "credit_text",
        "voice",
        "processing"
      ],
      "properties": {
        "id": {
          "type": "string",
          "pattern": "^[a-z0-9]+(?:-[a-z0-9]+)*$"
        },
        "file": {
          "type": "string",
          "pattern": "^[a-z0-9]+(?:-[a-z0-9]+)*/reference\\.wav$"
        },
        "sha256": {
          "$ref": "#/$defs/sha256"
        },
        "duration_sec": {
          "type": "number",
          "minimum": 10,
          "maximum": 20
        },
        "language": {
          "const": "ja"
        },
        "transcript": {
          "type": "string",
          "minLength": 1
        },
        "transcript_rights": {
          "$ref": "#/$defs/transcript_rights"
        },
        "source": {
          "$ref": "#/$defs/source"
        },
        "rights": {
          "$ref": "#/$defs/rights"
        },
        "credit_text": {
          "type": "string",
          "minLength": 1
        },
        "voice": {
          "$ref": "#/$defs/voice_profile"
        },
        "processing": {
          "$ref": "#/$defs/processing"
        }
      }
    },
    "transcript_rights": {
      "type": "object",
      "additionalProperties": false,
      "required": ["license", "evidence_url", "credit_text"],
      "properties": {
        "license": {
          "type": "string",
          "minLength": 1
        },
        "evidence_url": {
          "$ref": "#/$defs/url"
        },
        "credit_text": {
          "type": "string",
          "minLength": 1
        }
      }
    },
    "source": {
      "type": "object",
      "additionalProperties": false,
      "required": ["title", "speaker", "download_page", "files"],
      "properties": {
        "title": {
          "type": "string",
          "minLength": 1
        },
        "speaker": {
          "type": "string",
          "minLength": 1
        },
        "download_page": {
          "$ref": "#/$defs/url"
        },
        "files": {
          "type": "array",
          "minItems": 1,
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": ["label", "url", "sha256"],
            "properties": {
              "label": {
                "type": "string",
                "minLength": 1
              },
              "url": {
                "$ref": "#/$defs/url"
              },
              "sha256": {
                "$ref": "#/$defs/sha256"
              }
            }
          }
        }
      }
    },
    "rights": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "license",
        "verified_on",
        "voice_synthesis_evidence_url",
        "commercial_use_evidence_url",
        "redistribution"
      ],
      "properties": {
        "license": {
          "type": "string",
          "minLength": 1
        },
        "verified_on": {
          "type": "string",
          "format": "date"
        },
        "voice_synthesis_evidence_url": {
          "$ref": "#/$defs/url"
        },
        "commercial_use_evidence_url": {
          "$ref": "#/$defs/url"
        },
        "redistribution": {
          "type": "object",
          "additionalProperties": false,
          "required": ["status", "evidence_url", "notes"],
          "properties": {
            "status": {
              "enum": ["prohibited", "allowed_with_conditions"]
            },
            "evidence_url": {
              "$ref": "#/$defs/url"
            },
            "notes": {
              "type": "string",
              "minLength": 1
            }
          }
        }
      }
    },
    "voice_profile": {
      "type": "object",
      "additionalProperties": false,
      "required": ["gender", "age", "notes"],
      "properties": {
        "gender": {
          "enum": ["female", "male", "neutral"]
        },
        "age": {
          "enum": [
            "child",
            "teen",
            "young_adult",
            "adult",
            "middle_aged",
            "elderly"
          ]
        },
        "notes": {
          "type": "string",
          "minLength": 1
        }
      }
    },
    "processing": {
      "type": "object",
      "additionalProperties": false,
      "required": ["source_member", "source_sha256", "summary"],
      "properties": {
        "source_member": {
          "type": "string",
          "minLength": 1
        },
        "source_sha256": {
          "$ref": "#/$defs/sha256"
        },
        "summary": {
          "type": "string",
          "minLength": 1
        }
      }
    }
  }
}
